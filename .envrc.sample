export POSTGRESQL_USERNAME=username
export POSTGRESQL_PASSWORD=password
export POSTGRESQL_POSTGRES_PASSWORD=password
export POSTGRESQL_HOST=localhost
export POSTGRESQL_PORT=5432
export POSTGRESQL_DATABASE=postgres
export POSTGRESQL_DATABASE_URL="your-database-url"


# Testcontainers (Colima)
export TESTCONTAINERS_HOST_OVERRIDE=localhost
export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock
# Next.js dev server: extra hostnames allowed to load dev resources (HMR), comma-separated.
# Needed to open the app from another device on the network, e.g. 192.168.1.114 or 192.168.1.*
export ALLOWED_DEV_ORIGINS=
